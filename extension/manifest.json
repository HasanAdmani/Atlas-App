{
  "manifest_version": 3,
  "name": "Atlas Companion",
  "version": "1.1.0",
  "description": "One-click read-only sync for Canvas (courses, scores, due dates) and PSCS (past grades + live weekly schedule) to your private Atlas server.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://hulms.instructure.com/*",
    "https://pscs.habib.edu.pk/*",
    "https://*.simplesyllabus.com/*",
    "https://starserver.tailbf777f.ts.net/*",
    "http://127.0.0.1:3000/*",
    "http://localhost:3000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://hulms.instructure.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Atlas Companion"
  }
}
